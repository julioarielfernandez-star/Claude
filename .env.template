# ===================================
# Configuración de Entorno
# ===================================
# Copiar este archivo a .env y completar con tus credenciales

# Environment
ENVIRONMENT=development  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ===================================
# AI Services
# ===================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (GPT-4)
OPENAI_API_KEY=sk-xxxxx

# Cohere (Embeddings alternativos)
COHERE_API_KEY=xxxxx

# ===================================
# Vector Database
# ===================================

# Pinecone
PINECONE_API_KEY=xxxxx
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=knowledge_base

# ===================================
# Databases
# ===================================

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/consorcios_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=consorcios_db
DB_USER=admin
DB_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================
# Message Queue
# ===================================

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===================================
# Communication APIs
# ===================================

# Twilio (WhatsApp & SMS)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=info@julioarielfernandez.com.ar
SENDGRID_FROM_NAME=Administración Julio Ariel Fernández

# ===================================
# Payment Systems
# ===================================

# Interfast
INTERFAST_API_KEY=xxxxx
INTERFAST_BASE_URL=https://api.interfast.com.ar
INTERFAST_WEBHOOK_SECRET=xxxxx

# Banco Roela
BANCO_ROELA_API_KEY=xxxxx
BANCO_ROELA_BASE_URL=https://api.bancoroela.com.ar

# ===================================
# Cloud Storage
# ===================================

# AWS S3
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=consorcios-documents
AWS_REGION=us-east-1
AWS_CLOUDFRONT_DOMAIN=xxxxx.cloudfront.net

# ===================================
# OCR & Document Processing
# ===================================

# Google Cloud Vision
GOOGLE_CLOUD_PROJECT_ID=xxxxx
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# AWS Textract (alternativo)
AWS_TEXTRACT_REGION=us-east-1

# ===================================
# Monitoring & Observability
# ===================================

# Datadog
DATADOG_API_KEY=xxxxx
DATADOG_APP_KEY=xxxxx

# Sentry
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===================================
# Security
# ===================================

# JWT
JWT_SECRET_KEY=your_super_secret_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars

# ===================================
# Application Settings
# ===================================

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,https://julioarielfernandez.com.ar

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache TTL (seconds)
CACHE_TTL_SHORT=300      # 5 minutos
CACHE_TTL_MEDIUM=3600    # 1 hora
CACHE_TTL_LONG=86400     # 24 horas

# ===================================
# Business Logic
# ===================================

# Auto-approval thresholds (ARS)
AUTO_APPROVAL_THRESHOLD=10000
REQUIRES_COUNCIL_APPROVAL=50000

# Expense settings
EXPENSE_GENERATION_DAY=1
EXPENSE_DUE_DATE_OFFSET=10
EXPENSE_REMINDER_DAYS=7,3,1

# Maintenance
INSPECTION_FREQUENCY_DAYS=30
URGENT_RESPONSE_TIME_HOURS=1

# ===================================
# Feature Flags
# ===================================

FEATURE_AI_AUTO_RESPONSE=true
FEATURE_PREDICTIVE_MAINTENANCE=false
FEATURE_AUTO_BUDGET_APPROVAL=true
FEATURE_MULTILINGUAL_SUPPORT=false
